# OpsBrain environment variables
# Copy to .env and fill in real values — never commit .env to git

# ── Required ──────────────────────────────────────────────────────────────────
# Free tier: create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opsbrain
POSTGRES_USER=opsbrain

# ── Gemini model config (defaults shown; free tier via aistudio.google.com) ───
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
# Chat generation uses Groq; GOOGLE_API_KEY is only for Gemini embeddings.
# Create a Groq key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_ROUTER=openai/gpt-oss-20b
LLM_MODEL_ANSWER=openai/gpt-oss-120b
LLM_MODEL_SYNTH=qwen/qwen3.8-27b
# Optional Ollama: set LLM_BASE_URL=http://localhost:11434/v1,
# LLM_API_KEY=ollama and all three LLM_MODEL_* values to installed model names.
# In Docker Desktop use host.docker.internal instead of localhost.

# ── RAG tuning ────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ── Monitoring agent (Prometheus / Grafana / Alertmanager) ────────────────────
GRAFANA_API_TOKEN=

# ── Kafka (Stage 2) ───────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── AWS (Stage 3 — Terraform + EKS; also used by the Infra Agent) ───────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=

# ── Infra Agent (Kubernetes + Terraform) ─────────────────────────────────────
# KUBECONFIG=/path/to/kubeconfig   # leave unset to use the default (~/.kube/config)
# TERRAFORM_DIR=./infra/terraform  # set automatically in docker-compose

# ── Code Agent (GitHub PRs + Actions) ────────────────────────────────────────
# GITHUB_TOKEN=ghp_...             # needs repo + actions:read scopes
# GITHUB_REPO=your-org/your-repo

# ── GitHub Actions secrets (set in repo settings, not here) ──────────────────
# ARGOCD_SERVER=https://argocd.your-domain.com
# ARGOCD_TOKEN=
